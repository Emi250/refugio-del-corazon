---
import Base from '~/layouts/Base.astro';
import BigHeader from '~/components/BigHeader.astro';
import CTABlock from '~/components/CTABlock.astro';
import Lightbox from '~/components/Lightbox.astro';
import GalleryIndex from '~/components/GalleryIndex.astro';
import GallerySection from '~/components/GallerySection.astro';
import { getCollection } from 'astro:content';
import { t, localizedPath } from '~/i18n';
import { espaciosImages, ESPACIOS_ANCHOR } from '~/data/espacios';

const lang = 'en' as const;
const units = await getCollection('unidades', ({ data }) => data.lang === 'en');
const sorted = units.sort((a, b) => a.data.order - b.data.order);
const indexItems = [
  { anchor: ESPACIOS_ANCHOR, no: '00', label: t('sections.spaces', lang) },
  ...sorted.map(u => ({
    anchor: u.slug.replace(/^en\//, ''),
    no: `0${u.data.order}`,
    label: u.data.name_en ?? u.data.name,
  })),
];
const espacios = espaciosImages(lang);
---
<Base
  title="Photo gallery · Apartments in Capilla del Monte"
  description="Photos of the 4 short-term rental apartments in Capilla del Monte: interiors, exteriors, kitchen, bedrooms and shared courtyard."
>
  <BigHeader
    kicker="04 · GALLERY"
    title="Every corner"
    subtitle="Photo gallery of the 4 vacation rental apartments in Capilla del Monte"
    meta="REAL PHOTOS · NO FILTERS"
    blurb="A walk through the four units, the outdoors and the details that set the atmosphere of the refuge."
  />

  <GalleryIndex items={indexItems} lang={lang} />

  <GallerySection id={ESPACIOS_ANCHOR} title={t('sections.spaces', lang)} no="00" images={espacios} lang={lang} priority />
  {sorted.map(unit => <GallerySection id={unit.slug.replace(/^en\//, '')} title={unit.data.name_en ?? unit.data.name} no={`0${unit.data.order}`} images={unit.data.gallery} unit={unit.data.order} detail={localizedPath(`/unidades/${unit.slug.replace(/^en\//, '')}`, lang)} lang={lang} />)}

  <CTABlock lang={lang} />
  <Lightbox lang={lang} />
</Base>
