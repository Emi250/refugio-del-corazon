---
import Base from '~/layouts/Base.astro';
import BigHeader from '~/components/BigHeader.astro';
import CTABlock from '~/components/CTABlock.astro';
import { t, localizedPath } from '~/i18n';
import { GUIA_PATH } from '~/data/guia';
import { BUSINESS, MAP_EMBED_URL, directionsUrl } from '~/utils/seo';

const lang = 'en' as const;

const origins = [
  { name: 'From Córdoba City', origin: 'Córdoba, Argentina' },
  { name: 'From Buenos Aires', origin: 'Buenos Aires, Argentina' },
  { name: 'From Rosario', origin: 'Rosario, Santa Fe, Argentina' },
];

const nearGroups = [
  { category: 'Walking distance', items: [
    { name: 'Valpisa Pizzería', note: 'Wood-fired pizza', distance: '700 m · 10 min walk' },
    { name: 'Covered pedestrian street & Plaza San Martín', note: 'Covered street and artisan walk', distance: '800 m · 10 min walk' },
    { name: 'City Bar', note: 'Coffee, cakes and meals on the covered street', distance: '800 m · 10 min walk' },
  ]},
  { category: 'By car · Capilla & surroundings', items: [
    { name: 'Dique El Cajón & El Zapato', note: 'Natural overlook and sunsets over the reservoir', distance: '2.2 km · 5 min drive' },
    { name: 'Cerro Uritorco (trailhead)', note: 'Iconic trek with sweeping views of the Punilla valley', distance: '2.3 km · 5 min drive' },
    { name: 'La Toma · Río Calabalumba', note: 'Waterfalls and natural pools', distance: '2.3 km · 5 min drive' },
    { name: 'Los Mogotes', note: 'Rounded granite formations along the Río Dolores', distance: '4.3 km · 13 min drive' },
    { name: 'La Tramontana', note: 'Argentine restaurant', distance: '13 km · 23 min drive' },
    { name: 'Los Terrones Park', note: 'Rock formations: The Armchair, Finger of God, Indian Face', distance: '14 km · 25 min drive' },
  ]},
];


---
<Base
  title="Where to stay in Capilla del Monte · Río Negro 64"
  description="How to get to Capilla del Monte from Córdoba City, Buenos Aires or Rosario. Distance to Cerro Uritorco, El Zapato, Los Terrones. Plan your visit."
  ogType="article"
>
  <BigHeader
    kicker="03 · LOCATION"
    title="Rio Negro 64"
    subtitle="Where to stay in Capilla del Monte: how to get here and what is near Cerro Uritorco"
    meta="CAPILLA DEL MONTE · CÓRDOBA"
    blurb="800 m from downtown, 1 km from the bus terminal and 2.3 km from Cerro Uritorco. A strategic base to rest and explore."
  />

  <section class="loc-map-wrap">
    <div class="loc-map">
      <iframe
        class="loc-iframe"
        src={MAP_EMBED_URL}
        loading="lazy"
        allowfullscreen
        referrerpolicy="no-referrer-when-downgrade"
        title="Rio Negro 64, Capilla del Monte"
      ></iframe>
      <article class="loc-card frame-card">
        <span class="kicker">PIN</span>
        <h2>Rio Negro 64</h2>
        <p>Río Negro 64, Capilla del Monte. On-site parking for two cars, subject to availability; please check before you arrive.</p>
        <div class="loc-chips">
          <span class="chip">Center · 800 m</span>
          <span class="chip">Terminal · 1 km</span>
          <span class="chip">Uritorco · 2.3 km</span>
          <a class="chip chip-maps" href={BUSINESS.mapsUrl} target="_blank" rel="noopener">View on Google Maps ↗</a>
        </div>
      </article>
    </div>
  </section>

  <section class="block">
    <div class="block-head">
      <h2>{t('location.howToGet', lang)}</h2>
      <span class="spec-mono">3 ORIGINS</span>
    </div>
    <div class="origins-grid">
      {origins.map((o, i) => (
        <div class="origin">
          <span class="kicker">{o.name}</span>
          <div class="origin-dist display-no display-sm">0{i + 1}</div>
          <p class="origin-info">Check the current route, traffic and estimated travel time to our entrance before setting off.</p>
          <a class="link-acc" href={directionsUrl(o.origin)} target="_blank" rel="noopener">Get driving directions ↗</a>
        </div>
      ))}
    </div>
  </section>

  <section class="block">
    <div class="block-head"><h2>Arriving without a car</h2></div>
    <p>From the Capilla del Monte bus terminal, open the route to Río Negro 64 and select walking directions, or arrange a local taxi. If you have luggage, need a transfer or plan to arrive late, contact us before travelling so we can coordinate your arrival.</p>
    <a class="link-acc" href={directionsUrl()} target="_blank" rel="noopener">Route to our entrance ↗</a>
  </section>

  <section class="block bg-paper-2">
    <div class="block-head">
      <h2>{t('location.nearby', lang)}</h2>
      <span class="spec-mono">APPROXIMATE DISTANCES</span>
    </div>
    <div class="near-grid">
      {nearGroups.map(g => (
        <div class="near-col">
          <div class="near-cat kicker">{g.category}</div>
          {g.items.map(it => (
            <div class="near-row">
              <div>
                <a class="near-name" href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(it.name + ", Capilla del Monte, Córdoba")}`} target="_blank" rel="noopener">{it.name} ↗</a>
                {it.note && <div class="near-note">{it.note}</div>}
              </div>
              <span class="near-dist">{it.distance}</span>
            </div>
          ))}
        </div>
      ))}
    </div>
    <a class="link-acc near-guide" href={localizedPath(GUIA_PATH, lang)}>See the things-to-do guide →</a>
  </section>

<section class="block"><div class="block-head"><h2>Before you travel</h2></div><p>Check the weather forecast for your travel dates and any trail access conditions before setting out.</p><a class="link-acc" href="https://www.smn.gob.ar/" target="_blank" rel="noopener">National Weather Service ↗</a></section>

  <CTABlock lang={lang} background="paper-2" mapsUrl={BUSINESS.mapsUrl} />
</Base>

<style>
  .near-name { display: inline-flex; align-items: center; min-height: 44px; text-decoration: underline; text-underline-offset: 3px; }
  .near-row { min-width: 0; }
  .near-row > div { min-width: 0; }
  .origin-info { margin: 14px 0 18px; font-size: 14px; line-height: 1.6; color: var(--mf-ink-soft); }
  .bg-paper-2 { background: var(--mf-paper-2); }
  .chip-maps { background: var(--mf-action); color: var(--mf-paper); border-color: var(--mf-action); }
  .chip-maps:hover { background: var(--mf-ink); border-color: var(--mf-ink); color: var(--mf-paper); }
  .loc-map-wrap { background: var(--mf-paper-2); border-bottom: 1.5px solid var(--mf-ink); }
  .loc-map { position: relative; min-height: 480px; background-color: var(--mf-stone); overflow: hidden; }
  .loc-iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; z-index: 1; display: block; }
  .loc-card { position: absolute; left: 32px; top: 32px; padding: 24px 26px; max-width: 360px; z-index: 3; }
  .loc-card h2 { font-size: 28px; margin: 12px 0 10px; letter-spacing: -0.02em; font-weight: 700; }
  .loc-card p { font-size: 13.5px; line-height: 1.55; color: var(--mf-ink-soft); margin: 0 0 14px; }
  .loc-chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .block { padding: 36px 28px; border-bottom: 1.5px solid var(--mf-ink); background: var(--mf-paper); }
  .block-head { display: flex; justify-content: space-between; align-items: baseline; border-bottom: 1px solid var(--mf-hair); padding-bottom: 14px; margin-bottom: 22px; }
  .block-head h2 { font-size: 26px; letter-spacing: -0.025em; font-weight: 700; }
  .origins-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; border: 1px solid var(--mf-ink); }
  .origin { padding: 22px 24px; border-right: 1px solid var(--mf-hair); }
  .origin:last-child { border-right: 0; }
  .origin-dist { margin-top: 14px; }
  .origin-time { margin-top: 6px; }
  .origin-steps { padding-left: 20px; margin: 18px 0 0; font-size: 13px; line-height: 1.55; color: var(--mf-ink-soft); }
  .origin-steps li { margin-bottom: 5px; }
  .near-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0 40px; }
  .near-cat { padding: 18px 0 10px; border-top: 1px solid var(--mf-hair); letter-spacing: 0.18em; }
  .near-row { display: flex; justify-content: space-between; padding: 11px 0; border-top: 1px solid var(--mf-hair); align-items: flex-start; gap: 10px; }
  .near-name { font-size: 13.5px; font-weight: 500; letter-spacing: -0.005em; }
  .near-note { font-size: 11px; color: var(--mf-ink-soft); margin-top: 2px; }
  .near-dist { font-size: 13px; font-weight: 600; }
  .near-guide { margin-top: 22px; }
  @media (max-width: 900px) {
    .origins-grid { grid-template-columns: 1fr; }
    .origin { border-right: 0; border-bottom: 1px solid var(--mf-hair); }
    .origin:last-child { border-bottom: 0; }
    .near-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 720px) {
    .block { padding: 22px 18px; }
    .loc-map { min-height: auto; padding: 0; aspect-ratio: auto; }
    .loc-card { position: relative; max-width: none; margin: 18px; }
  }
@media (max-width: 720px) { .loc-iframe { position: static; height: 300px; } }
</style>
