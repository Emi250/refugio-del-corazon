---
import Base from '~/layouts/Base.astro';
import BigHeader from '~/components/BigHeader.astro';
import CTABlock from '~/components/CTABlock.astro';
import Lightbox from '~/components/Lightbox.astro';
import GalleryIndex from '~/components/GalleryIndex.astro';
import GallerySection from '~/components/GallerySection.astro';
import { getCollection } from 'astro:content';
import { t, localizedPath } from '~/i18n';
import { espaciosImages, ESPACIOS_ANCHOR } from '~/data/espacios';

const lang = 'es' as const;
const units = await getCollection('unidades', ({ data }) => data.lang === 'es');
const sorted = units.sort((a, b) => a.data.order - b.data.order);
const indexItems = [
  { anchor: ESPACIOS_ANCHOR, no: '00', label: t('sections.spaces', lang) },
  ...sorted.map(u => ({
    anchor: u.slug,
    no: `0${u.data.order}`,
    label: u.data.name,
  })),
];
const espacios = espaciosImages(lang);
---
<Base
  title="Galería de fotos · Departamentos en Capilla del Monte"
  description="Fotos de los 4 departamentos de alquiler temporario en Capilla del Monte: interiores, exteriores, cocina, dormitorios y patio compartido."
>
  <BigHeader
    kicker="04 · GALERÍA"
    title="Cada rincón"
    subtitle="Galería de fotos de los 4 departamentos de alquiler temporario en Capilla del Monte"
    meta="FOTOS REALES · SIN FILTROS"
    blurb="Un recorrido por las cuatro unidades, los exteriores y los detalles que dan la atmósfera al refugio."
  />

  <GalleryIndex items={indexItems} lang={lang} />

  <GallerySection id={ESPACIOS_ANCHOR} title={t('sections.spaces', lang)} no="00" images={espacios} lang={lang} />
  {sorted.map(unit => <GallerySection id={unit.slug.replace(/^en\//, '')} title={unit.data.name} no={`0${unit.data.order}`} images={unit.data.gallery} unit={unit.data.order} detail={localizedPath(`/unidades/${unit.slug.replace(/^en\//, '')}`, lang)} lang={lang} />)}

  <CTABlock lang={lang} />
  <Lightbox lang={lang} />
</Base>
