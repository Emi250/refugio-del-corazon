---
import { Image } from 'astro:assets';
import { t, type Lang, localizedPath, unitNo, unitLabel } from '~/i18n';
import { waLinkForUnit } from '~/utils/whatsapp';
import { lightboxVariants } from '~/utils/images';
import parque from '~/assets/images/espacios/parque.jpg';
import living4 from '~/assets/images/unidades/unidad-4/living.jpg';
import cocina1 from '~/assets/images/unidades/unidad-1/cocina.jpg';
import dorm3 from '~/assets/images/unidades/unidad-3/dormitorio.jpg';
import detalle1 from '~/assets/images/unidades/unidad-1/ropa-de-cama.jpg';
import bano1 from '~/assets/images/unidades/unidad-1/bano.jpg';

interface Props { lang?: Lang; images?: { src: ImageMetadata; caption?: string; unit?: number }[] }

const { lang = 'es', images } = Astro.props;

// Los captions estaban hardcodeados en castellano y la home en ingles mostraba
// "Bano" y "Dormitorio".
const defaults = [
  { src: parque, caption: t('galleryStrip.exterior', lang) },
  { src: living4, unit: 4, caption: t('galleryStrip.living', lang) },
  { src: cocina1, unit: 1, caption: t('galleryStrip.kitchen', lang) },
  { src: dorm3, unit: 3, caption: t('galleryStrip.bedroom', lang) },
  { src: detalle1, unit: 1, caption: t('galleryStrip.details', lang) },
  { src: bano1, unit: 1, caption: t('galleryStrip.bathroom', lang) },
];
const shown = (images ?? defaults).slice(0, 6);
const full = await lightboxVariants(shown);
const photoTitle = (unit?: number) => unit ? unitLabel(unit, lang) : t('sections.spaces', lang);
const photoAlt = (img: {caption?: string; unit?: number}, i: number) => `${photoTitle(img.unit)} · ${img.caption ?? (lang === 'es' ? 'Foto' : 'Photo') + ' ' + (i + 1)}`;
---
<section class="gallery-strip">
  <div class="gs-grid">
    {shown.map((img, i) => (
      <a href={full[i].lg} data-lb-sm={full[i].sm} class="gs-cell" data-lb-group="home-strip" data-lb-index={i} data-lb-title={photoTitle(img.unit)} data-lb-unit={img.unit ? `unidad-${img.unit}` : ''} data-lb-wa={img.unit ? waLinkForUnit(unitLabel(img.unit, lang), lang) : undefined} data-lb-detail={img.unit ? localizedPath(`/unidades/unidad-${img.unit}`, lang) : undefined} data-lb-caption={img.caption ?? ''} aria-label={photoAlt(img, i)}>
        <Image src={img.src} alt={photoAlt(img, i)} width={600} widths={[300, 600]} sizes="(max-width: 480px) 50vw, (max-width: 900px) 33vw, 17vw" loading="lazy" decoding="async" />
        {img.caption && <span class="gs-cap">{img.unit ? `${unitNo(img.unit, lang)} · ` : ''}{img.caption}</span>}
      </a>
    ))}
  </div>
  <a href={localizedPath('/galeria', lang)} class="gs-cta">{t('unit.viewGallery', lang)} →</a>
</section>

<style>
  .gallery-strip {
    background: var(--mf-paper);
    border-bottom: 1.5px solid var(--mf-ink);
  }
  .gs-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    border-bottom: 1px solid var(--mf-hair);
  }
  .gs-cell {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: var(--mf-stone);
    border-right: 1px solid var(--mf-hair);
    display: block;
    cursor: zoom-in;
  }
  .gs-cell:last-child { border-right: 0; }
  .gs-cell img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .gs-cell:hover img { transform: scale(1.04); }
  .gs-cap {
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: 10px;
    width: fit-content;
    max-width: calc(100% - 20px);
    padding: 4px 8px;
    line-height: 1.35;
    background: rgba(27, 26, 22, 0.78);
    backdrop-filter: blur(8px);
    color: var(--mf-paper);
    font-family: var(--mf-font-mono);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0;
    text-transform: none;
  }
  .gs-cta {
    display: block;
    padding: 18px 28px;
    font-size: 14px;
    font-weight: 600;
    color: var(--mf-ink);
    border-bottom: 2px solid var(--mf-accent);
    width: fit-content;
    margin: 0 28px;
  }
  .gs-cta:hover { color: var(--mf-action); }

  @media (max-width: 900px) {
    .gs-grid { grid-template-columns: repeat(3, 1fr); }
    .gs-cell { border-right: 1px solid var(--mf-hair); }
    .gs-cell:nth-child(3n) { border-right: 0; }
    .gs-cell:nth-child(n+4) { border-top: 1px solid var(--mf-hair); }
    .gs-cta { margin: 0 18px; padding: 14px 0; }
  }

  @media (max-width: 480px) {
    .gs-grid { grid-template-columns: repeat(2, 1fr); }
    .gs-cell { border-right: 1px solid var(--mf-hair); }
    .gs-cell:nth-child(3n) { border-right: 1px solid var(--mf-hair); }
    .gs-cell:nth-child(2n) { border-right: 0; }
    .gs-cell:nth-child(n+3) { border-top: 1px solid var(--mf-hair); }
    .gs-cell:nth-child(-n+2) { border-top: 0; }
    .gs-cap { font-size: 12px; padding: 4px 7px; left: 8px; bottom: 8px; }
  }
</style>
