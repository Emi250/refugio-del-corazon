---
import type { CollectionEntry } from 'astro:content';
import { localizedPath, t, type Lang } from '~/i18n';
interface Props { units: CollectionEntry<'unidades'>[]; lang: Lang }
const { units, lang } = Astro.props;
---
<section class="comparison" aria-label={lang === 'es' ? 'Comparar departamentos' : 'Compare apartments'}>
  <p class="comparison-intro">{t('sections.unitsIntro', lang)}</p>
  <div class="comparison-grid">
    {units.map(({slug, data}) => (
      <article class="comparison-unit">
        <h3><a href={localizedPath(`/unidades/${slug.split('/').pop()}`, lang)}>{lang === 'es' ? data.name : data.name_en ?? data.name}<span aria-hidden="true"> ↗</span></a></h3>
        <p class="comparison-capacity">{data.specs.capacidad} <span>· {data.specs.metros}</span></p>
        <dl><dt>{lang === 'es' ? 'Distribución' : 'Layout'}</dt><dd>{data.specs.ambientes}</dd><dt>{lang === 'es' ? 'Camas' : 'Beds'}</dt><dd>{data.beds}</dd></dl>
        <p class="comparison-note">{data.decision_note}</p>
      </article>
    ))}
  </div>
</section>
<style>
 .comparison { padding: 24px 28px 32px; border-bottom: 1px solid var(--mf-ink); }
 .comparison-intro { max-width: 65ch; margin: 0 0 24px; color: var(--mf-ink-soft); }
 .comparison-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border: 1px solid var(--mf-ink); }
 .comparison-unit { padding: 24px; border-right: 1px solid var(--mf-hair); display: flex; flex-direction: column; }
 .comparison-unit:last-child { border-right: 0; }
 h3 { font-size: 20px; line-height: 1.2; }
 h3 a { text-decoration: underline; text-decoration-color: var(--mf-action); text-underline-offset: 5px; }
 .comparison-capacity { font-size: 15px; font-weight: 600; margin: 16px 0; }
 .comparison-capacity span { white-space: nowrap; font-weight: 400; }
 dl { margin: 0 0 24px; font-size: 14px; }
 dt { color: var(--mf-ink-soft); margin-top: 12px; }
 dd { margin: 4px 0 0; }
 .comparison-note { margin: auto 0 0; padding-top: 16px; border-top: 1px solid var(--mf-hair); font-size: 14px; font-weight: 500; }
 @media(max-width:1100px) { .comparison-grid { grid-template-columns: repeat(2,minmax(0,1fr)); } .comparison-unit:nth-child(2n) { border-right: 0; } .comparison-unit:nth-child(-n+2) { border-bottom: 1px solid var(--mf-hair); } }
 @media(max-width:600px) { .comparison { padding: 20px 18px; } .comparison-grid { grid-template-columns: 1fr; } .comparison-unit { border-right: 0; border-bottom: 1px solid var(--mf-hair); padding: 20px; } .comparison-unit:last-child { border-bottom: 0; } dl { display: grid; grid-template-columns: 85px 1fr; gap: 8px; margin-bottom: 16px; } dt, dd { margin: 0; } }
</style>
