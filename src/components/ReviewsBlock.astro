---
import { t, type Lang } from '~/i18n';
import { BUSINESS } from '~/utils/seo';
interface Props { lang?: Lang; class?: string; }
const { lang = 'es', class: className = '' } = Astro.props;
---
<section class={`reviews ${className}`} aria-labelledby="reviews-heading">
  <span class="kicker">{t('sections.reviews', lang)}</span>
  <h2 id="reviews-heading">{lang === 'es' ? 'La experiencia de quienes se alojaron' : 'From guests who stayed here'}</h2>
  <p>{lang === 'es' ? 'Leé las experiencias y puntuaciones de huéspedes en Booking.com.' : 'Read guest experiences and ratings on Booking.com, with translation options available there.'}</p>
  <a class="link-acc" href={BUSINESS.bookingUrl} target="_blank" rel="noopener">{t('reviews.verified', lang)}</a>
  {lang === 'es' && <div class="reviews-embed">
    <button type="button" class="reviews-load" hidden>Mostrar reseñas aquí</button>
    <p class="reviews-status" role="status"></p>
    <div class="widget-frame" hidden><div class="elfsight-app-e958aa7b-7c8f-4da7-9ca0-94674ae030c2"></div></div>
    <small>Al mostrarlas, se conecta con Elfsight, el proveedor del panel de reseñas.</small>
  </div>}
</section>
<script>
  const button = document.querySelector<HTMLButtonElement>('.reviews-load');
  const frame = document.querySelector<HTMLElement>('.widget-frame');
  const status = document.querySelector<HTMLElement>('.reviews-status');
  if (button && frame && status) {
    button.hidden = false;
    button.addEventListener('click', () => {
      button.hidden = true;
      status.textContent = 'Cargando reseñas… Podés abrir Booking.com mientras tanto.';
      frame.hidden = false;
      const script = document.createElement('script');
      script.src = 'https://static.elfsight.com/platform/platform.js';
      script.async = true;
      let timer: ReturnType<typeof setTimeout>;
      const observer = new MutationObserver(() => {
        // The provider can render inline rather than in an iframe. Detect its
        // visible content without depending on generated class names.
        if (frame.innerText.trim() || frame.querySelector('iframe')) { status.textContent = ''; clearTimeout(timer); observer.disconnect(); }
      });
      const fallback = () => { status.textContent = 'Si el panel no aparece, podés leer todas las reseñas en el enlace a Booking.com.'; };
      observer.observe(frame, { childList: true, subtree: true });
      timer = setTimeout(fallback, 15000);
      script.onerror = () => { clearTimeout(timer); observer.disconnect(); fallback(); };
      window.addEventListener('pagehide', () => { clearTimeout(timer); observer.disconnect(); }, { once: true });
      document.head.append(script);
    }, { once: true });
  }
</script>
<style>
  .reviews { padding: clamp(32px,6vw,80px) 28px; border-bottom: 1.5px solid var(--mf-ink); }
  h2 { font-size: clamp(26px,3vw,42px); line-height: 1.15; letter-spacing: -.03em; margin: 18px 0; }
  p { font-size: 16px; line-height: 1.6; max-width: 65ch; }
  a, button { display: inline-flex; align-items: center; min-height: 44px; margin-top: 16px; }
  button { border: 1px solid var(--mf-ink); background: transparent; padding: 12px 18px; cursor: pointer; }
  [hidden] { display: none; }
  small { display: block; color: var(--mf-ink-soft); font-size: 13px; margin-top: 12px; }
  .widget-frame { margin-top: 18px; }
  @media(max-width:720px) { .reviews { padding-inline: 18px; } }
</style>
