---
import BrandMark from './BrandMark.astro';
import WhatsAppCTA from './WhatsAppCTA.astro';
import { t, type Lang, localizedPath, otherLangPath, withTrailingSlash } from '~/i18n';

interface Props {
  variant?: 'hero' | 'paper';
  lang?: Lang;
  message?: string;
}

const { variant = 'paper', lang = 'es', message } = Astro.props;
const isHero = variant === 'hero';

const links = [
  { href: localizedPath('/#unidades', lang), label: t('nav.units', lang) },
  { href: localizedPath('/servicios', lang), label: t('nav.services', lang) },
  { href: localizedPath('/ubicacion', lang), label: t('nav.location', lang) },
  { href: localizedPath('/galeria', lang), label: t('nav.gallery', lang) },
  { href: localizedPath('/faq', lang), label: t('nav.faq', lang) },
];

const currentPath = /^\/404(?:\.html)?\/?$/.test(Astro.url.pathname) ? '/' : Astro.url.pathname;
const active = (href: string) => href.includes('#unidades') ? /\/unidades\//.test(currentPath) : currentPath === href;
const otherLang: Lang = lang === 'es' ? 'en' : 'es';
const otherPath = otherLangPath(currentPath, lang);
const esPath = lang === 'es' ? withTrailingSlash(currentPath) : otherPath;
const enPath = lang === 'en' ? withTrailingSlash(currentPath) : otherPath;
---
<nav
  class={`nav ${isHero ? 'nav-hero' : 'nav-paper'}`}
  aria-label={lang === 'es' ? 'Navegación principal' : 'Main navigation'}
>
  <a href={localizedPath('/', lang)} class="nav-brand">
    <BrandMark inverted={isHero} size={isHero ? 32 : 30} decorative />
    <span class="nav-name">El Refugio del Corazón</span>
  </a>

  <div class="nav-links">
    {links.map(({ href, label }) => (
      <a href={href} class="nav-link" aria-current={active(href) ? 'page' : undefined}>{label}</a>
    ))}
  </div>

  <div class="nav-actions">
    <div class="nav-lang" role="group" aria-label={lang === 'es' ? 'Idioma' : 'Language'}>
      <a href={esPath} class={`nav-lang-btn ${lang === 'es' ? 'on' : ''}`} data-switch-lang="es">ES</a>
      <span class="nav-lang-sep">/</span>
      <a href={enPath} class={`nav-lang-btn ${lang === 'en' ? 'on' : ''}`} data-switch-lang="en">EN</a>
    </div>
    <WhatsAppCTA lang={lang} message={message} variant="small" placement="navigation" class="nav-cta" />
  </div>

  <button
    class="nav-burger"
    type="button"
    aria-label={t('common.openMenu', lang)}
    aria-expanded="false"
    aria-controls="nav-mobile-menu"
    data-burger
    data-label-open={t('common.openMenu', lang)}
    data-label-close={t('common.closeMenu', lang)}
  >
    <span></span><span></span><span></span>
  </button>
</nav>

<dialog class="nav-mobile-menu" id="nav-mobile-menu" data-mobile-menu aria-label={t('common.menu', lang)}>
  <div class="mobile-menu-head"><span>El Refugio del Corazón</span><button class="menu-close" type="button" aria-label={t('common.closeMenu', lang)} data-menu-close>×</button></div>
  {links.map(({ href, label }) => (
    <a href={href} class="nav-mobile-link" aria-current={active(href) ? 'page' : undefined}>{label}</a>
  ))}
  <div class="nav-mobile-foot">
    <div class="nav-lang">
      <a href={esPath} class={`nav-lang-btn ${lang === 'es' ? 'on' : ''}`} data-switch-lang="es">ES</a>
      <span class="nav-lang-sep">/</span>
      <a href={enPath} class={`nav-lang-btn ${lang === 'en' ? 'on' : ''}`} data-switch-lang="en">EN</a>
    </div>
    <WhatsAppCTA lang={lang} message={message} variant="big" placement="mobile_menu" fullWidth />
  </div>
</dialog>
<noscript><nav class="nav-fallback" aria-label={lang === 'es' ? 'Navegación móvil' : 'Mobile navigation'}>{links.map(({href,label}) => <a href={href}>{label}</a>)}<a href={otherPath}>{otherLang.toUpperCase()}</a></nav></noscript>

<script>
  const burger = document.querySelector<HTMLButtonElement>('[data-burger]');
  const menu = document.querySelector<HTMLDialogElement>('[data-mobile-menu]');
  if (burger && menu) {
    burger.dataset.ready = 'true';
    let previousOverflow = '';
    const close = () => { if (menu.open) menu.close(); };
    burger.addEventListener('click', () => {
      previousOverflow = document.body.style.overflow;
      menu.showModal();
      document.body.style.overflow = 'hidden';
      burger.setAttribute('aria-expanded', 'true');
      menu.querySelector<HTMLButtonElement>('[data-menu-close]')?.focus();
    });
    menu.addEventListener('close', () => {
      document.body.style.overflow = previousOverflow;
      burger.setAttribute('aria-expanded', 'false');
      if (getComputedStyle(burger).display !== 'none') burger.focus();
      else document.querySelector<HTMLAnchorElement>('.nav-brand')?.focus();
    });
    menu.querySelector('[data-menu-close]')?.addEventListener('click', close);
    menu.querySelectorAll('a').forEach(a => a.addEventListener('click', close));
    const desktop = matchMedia('(min-width: 901px)');
    desktop.addEventListener('change', e => { if (e.matches) close(); });
  }

  document.querySelectorAll<HTMLAnchorElement>('[data-switch-lang]').forEach(link => {
    const base = link.getAttribute('href')!;
    const sync = () => { link.href = base + location.hash; };
    sync();
    window.addEventListener('hashchange', sync);
    link.addEventListener('click', () => {
      try { localStorage.setItem('pref-lang', link.dataset.switchLang!); } catch {}
    });
  });

  const nav = document.querySelector('.nav-paper, .nav-hero') as HTMLElement | null;
  if (nav) {
    const threshold = nav.classList.contains('nav-hero') ? 80 : 4;
    const update = () => nav.classList.toggle('is-scrolled', window.scrollY > threshold);
    update();
    window.addEventListener('scroll', update, { passive: true });

    // Alto real de la nav -> lo consumen el scroll-padding de las anclas y el
    // indice sticky de /galeria, que si no tienen que adivinarlo.
    const measure = () => {
      document.documentElement.style.setProperty('--mf-nav-h', `${nav.offsetHeight}px`);
    };
    measure();
    window.addEventListener('resize', measure, { passive: true });
  }
</script>

<style>
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 28px;
    gap: 22px;
    position: sticky;
    top: 0;
    z-index: 50;
    transition: background 0.2s, border-color 0.2s;
  }
  .nav-paper {
    background: var(--mf-paper);
    color: var(--mf-ink);
    border-bottom: 1px solid var(--mf-hair);
    transition: background 0.2s, border-color 0.2s, box-shadow 0.2s;
  }
  .nav-paper.is-scrolled {
    box-shadow: 0 6px 18px -14px rgba(27, 26, 22, 0.4);
  }
  /* Fija, no absoluta: sobre el hero arranca transparente y al scrollear
     vira a paper. Con `absolute` la nav se iba con el scroll y el home
     quedaba sin ningun acceso a /galeria (y sin burger en mobile). */
  .nav-hero {
    background: transparent;
    color: var(--mf-paper);
    border-bottom: 1px solid rgba(244, 240, 230, 0.15);
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 50;
  }
  .nav-hero.is-scrolled {
    background: var(--mf-paper);
    color: var(--mf-ink);
    border-bottom-color: var(--mf-hair);
    box-shadow: 0 6px 18px -14px rgba(27, 26, 22, 0.4);
  }
  .nav-hero.is-scrolled .nav-link { opacity: 0.75; }

  .nav-brand {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.005em;
    color: inherit;
  }
  .nav-name { white-space: nowrap; }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 22px;
    flex: 1;
    justify-content: center;
  }
  .nav-link {
    font-size: 13px;
    font-weight: 500;
    letter-spacing: -0.005em;
    color: inherit;
    opacity: 0.75;
    transition: opacity 0.15s, color 0.15s;
  }
  .nav-link:hover { opacity: 1; }
  .nav-hero .nav-link { opacity: 0.85; }

  .nav-actions { display: flex; align-items: center; gap: 18px; }
  .nav-lang {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: var(--mf-font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
  }
  .nav-lang-btn {
    padding: 10px;
    min-width: 44px;
    min-height: 44px;
    display: inline-grid;
    place-items: center;
    opacity: 1;
    color: inherit;
    transition: opacity 0.15s;
  }
  .nav-lang-btn:hover { opacity: 1; }
  .nav-lang-btn.on {
    opacity: 1;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: var(--mf-accent);
    text-underline-offset: 4px;
    text-decoration-thickness: 2px;
  }
  .nav-lang-sep { opacity: 0.4; }

  .nav-cta { padding: 8px 14px !important; font-size: 12px !important; }
  .nav-hero .nav-cta {
    background: var(--mf-paper);
    color: var(--mf-ink);
    box-shadow: none;
  }
  .nav-hero.is-scrolled .nav-cta {
    background: var(--mf-action);
    color: var(--mf-paper);
    box-shadow: var(--mf-shadow-cta);
  }

  .nav-burger {
    display: none;
    background: transparent;
    border: 0;
    width: 44px;
    height: 44px;
    padding: 11px 8px;
    flex-shrink: 0;
    cursor: pointer;
    flex-direction: column;
    justify-content: space-between;
  }
  .nav-burger span {
    display: block;
    height: 2px;
    background: currentColor;
    border-radius: 1px;
    transition: transform 0.2s;
  }
  .nav-burger.open span:nth-child(1) { transform: translateY(10px) rotate(45deg); }
  .nav-burger.open span:nth-child(2) { opacity: 0; }
  .nav-burger.open span:nth-child(3) { transform: translateY(-10px) rotate(-45deg); }

  .nav-mobile-menu {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background: var(--mf-paper);
    z-index: 40;
    margin: 0;
    border: 0;
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    overflow-y: auto;
    overscroll-behavior: contain;
    color: var(--mf-ink);
    padding: 16px 24px 24px;
    flex-direction: column;
    gap: 6px;
  }
  .nav-mobile-menu[open] { display: flex; }
  .nav-mobile-menu:not([open]) { display: none; }
  .nav-mobile-link {
    padding: 16px 0;
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.015em;
    border-bottom: 1px solid var(--mf-hair);
    color: var(--mf-ink);
  }
  .nav-mobile-foot {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding-top: 24px;
  }

  @media (max-width: 900px) {
    .nav {
      padding-top: 14px;
      padding-bottom: 14px;
      padding-left: max(18px, env(safe-area-inset-left));
      padding-right: max(18px, env(safe-area-inset-right));
    }
    .nav-links, .nav-actions { display: none; }
    .nav-burger[data-ready] { display: flex; }
    .nav-name { display: block; white-space: normal; font-size: 14px; max-width: 19ch; line-height: 1.15; }
    .nav-mobile-menu {
      padding-left: max(24px, env(safe-area-inset-left));
      padding-right: max(24px, env(safe-area-inset-right));
      padding-bottom: max(24px, env(safe-area-inset-bottom));
    }
  }
.nav-link[aria-current], .nav-mobile-link[aria-current] { opacity: 1; font-weight: 700; text-decoration: underline; text-decoration-color: var(--mf-action); text-underline-offset: 7px; }
  .nav-links { gap: clamp(10px, 1.6vw, 22px); }
  .nav-actions { gap: 10px; }
  .mobile-menu-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; font-weight: 700; }
  .menu-close { flex-shrink: 0; display: grid; place-items: center; width: 44px; height: 44px; border: 1px solid var(--mf-ink); border-radius: 50%; color: var(--mf-ink); background: var(--mf-paper); font-size: 28px; cursor: pointer; }
  .nav-mobile-link, .nav-mobile-foot, .mobile-menu-head { flex-shrink: 0; }
  .nav-fallback { display: flex; flex-wrap: wrap; gap: 12px; padding: 16px 18px; margin-top: 80px; }
  .nav-fallback a { padding: 10px; text-decoration: underline; }
  @media(min-width: 901px) and (max-width: 1100px) { .nav-name { max-width: 15ch; white-space: normal; line-height: 1.2; } .nav { gap: 12px; padding-inline: 18px; } }
  </style>
