---
import { t, type Lang } from '~/i18n';

interface Props {
  href: string;
  lang?: Lang;
  variant?: 'big' | 'small';
  class?: string;
}

const { href, lang = 'es', variant = 'big', class: className = '' } = Astro.props;
---
<a
  href={href}
  target="_blank"
  rel="noopener"
  class={`video-cta video-cta-${variant} ${className}`}
>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect x="2" y="4" width="14" height="16" rx="2" />
    <path d="M16 10l6-3v10l-6-3z" />
  </svg>
  <span>{t('unit.videoCta', lang)}</span>
</a>

<style>
  .video-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    border: 1.5px solid var(--mf-ink);
    border-radius: 999px;
    background: var(--mf-paper);
    color: var(--mf-ink);
    text-decoration: none;
    font-weight: 600;
    letter-spacing: -0.01em;
    white-space: nowrap;
    transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }
  .video-cta svg { width: 18px; height: 18px; flex-shrink: 0; }

  .video-cta-big { padding: 13px 22px; font-size: 15px; }
  .video-cta-small { padding: 9px 16px; font-size: 13px; }
  .video-cta-small svg { width: 15px; height: 15px; }

  .video-cta:hover {
    background: var(--mf-ink);
    color: var(--mf-paper);
    transform: translateY(-1px);
  }
  .video-cta:focus-visible { outline-offset: 4px; }

  @media (max-width: 720px) {
    .video-cta-big { padding: 12px 18px; font-size: 14px; }
  }
</style>
