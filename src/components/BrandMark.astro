---
import { Image } from 'astro:assets';
import logo from '~/assets/images/brand/logo-refugio.jpeg';

interface Props {
  inverted?: boolean;
  size?: number;
  class?: string;
  decorative?: boolean;
}
const { size = 36, class: cls = '', inverted = false, decorative = false } = Astro.props;
---
<Image
  src={logo}
  alt={decorative ? '' : 'El Refugio del Corazón'}
  class={`brand-mark-img ${inverted ? 'inverted' : ''} ${cls}`}
  width={size}
  height={size}
  densities={[1, 2, 3]}
  loading="eager"
  format="webp"
  quality={80}
  style={`width:${size}px;height:${size}px;`}
/>

<style>
  .brand-mark-img {
    display: inline-block;
    object-fit: cover;
    border-radius: 999px;
    flex-shrink: 0;
    border: 1px solid var(--mf-ink-soft);
  }
.brand-mark-img.inverted { border-color: var(--mf-paper); }
</style>
