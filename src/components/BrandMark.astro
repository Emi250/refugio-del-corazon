---
import { Image } from 'astro:assets';
import logo from '~/assets/images/brand/logo-refugio.jpeg';

interface Props {
  inverted?: boolean;
  size?: number;
  class?: string;
}
const { size = 36, class: cls = '' } = Astro.props;
---
<Image
  src={logo}
  alt="El Refugio del Corazón"
  class={`brand-mark-img ${cls}`}
  width={size}
  height={size}
  densities={[1, 2, 3]}
  loading="eager"
  format="webp"
  quality={80}
  style={`width:${size}px;height:${size}px;`}
/>

<style>
  .brand-mark-img {
    display: inline-block;
    object-fit: cover;
    border-radius: 999px;
    flex-shrink: 0;
  }
</style>
