---
import { Image } from 'astro:assets';
import { t, type Lang, localizedPath } from '~/i18n';
import { lightboxVariants } from '~/utils/images';

interface MosaicImage { src: ImageMetadata; caption?: string }
interface Props {
  images: MosaicImage[];
  lang?: Lang;
  group?: string;
  unitName?: string;
  ctaHref?: string;
  priority?: boolean;
}

const { images, lang = 'es', group, unitName, ctaHref, priority = false } = Astro.props;
const loadAttrs = (i: number) => priority && i === 0
  ? { loading: 'eager' as const, fetchpriority: 'high' as const }
  : { loading: 'lazy' as const };
const galleryHref = ctaHref ?? localizedPath('/galeria', lang);
const altSuffix = unitName
  ? (lang === 'en' ? ` — ${unitName}, apartment in Capilla del Monte` : ` — ${unitName}, departamento en Capilla del Monte`)
  : '';
const fallbackAlt = (i: number) => lang === 'en'
  ? `Photo ${i + 1}${altSuffix}`
  : `Foto ${i + 1}${altSuffix}`;
const captionAlt = (cap: string) => `${cap}${altSuffix}`;
const padded: (MosaicImage | null)[] = [...images];
while (padded.length < 5) padded.push(null);
const visible = padded.slice(0, 5);
const hidden = group ? images.slice(5) : [];
const full = await lightboxVariants(images);
---
{group && (
  <div class="mos-hint">
    <span class="kicker">{t('unit.tapHint', lang)}</span>
    <span class="spec-mono mos-hint-count">{images.length} {t('unit.photos', lang)}</span>
  </div>
)}
<div class="mosaic">
  {visible.map((img, i) => (
    <div class={`mos-cell mos-cell-${i + 1}`} style={`--i:${i}`}>
      {img && (group ? (
        <a href={full[i].lg} data-lb-sm={full[i].sm} class="mos-link" data-lb-group={group} data-lb-index={i} data-lb-title={unitName ?? ''} data-lb-caption={img.caption ?? ''} data-lb-alt={img.caption ? captionAlt(img.caption) : fallbackAlt(i)} aria-label={img.caption ?? `Foto ${i + 1}`}>
          <Image src={img.src} alt={img.caption ? captionAlt(img.caption) : fallbackAlt(i)} width={1200} widths={[400, 800, 1200]} sizes="(max-width: 900px) 100vw, 45vw" {...loadAttrs(i)} decoding="async" />
          {img.caption && <span class="mos-cap">{img.caption}</span>}
        </a>
      ) : (
        <>
          <Image src={img.src} alt={img.caption ? captionAlt(img.caption) : fallbackAlt(i)} width={1200} widths={[400, 800, 1200]} sizes="(max-width: 900px) 100vw, 45vw" {...loadAttrs(i)} decoding="async" />
          {img.caption && <span class="mos-cap">{img.caption}</span>}
        </>
      ))}
      {i === 4 && hidden.length > 0 && (
        <span class="mos-more" aria-hidden="true">+{hidden.length} {t('unit.photos', lang)}</span>
      )}
      {i === 4 && (
        <a href={galleryHref} class="mos-cta">{t('unit.viewGallery', lang)} →</a>
      )}
    </div>
  ))}
  {hidden.map((img, k) => (
    <a hidden href={full[k + 5].lg} data-lb-sm={full[k + 5].sm} data-lb-group={group} data-lb-index={k + 5} data-lb-title={unitName ?? ''} data-lb-caption={img.caption ?? ''} data-lb-alt={img.caption ? captionAlt(img.caption) : fallbackAlt(k + 5)} aria-hidden="true" tabindex="-1"></a>
  ))}
</div>

<style>
  .mosaic {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    grid-template-rows: 240px 240px;
    border-bottom: 1.5px solid var(--mf-ink);
    background: var(--mf-stone);
  }
  @keyframes mosIn {
    from { opacity: 0; transform: translateY(10px) scale(0.985); }
    to   { opacity: 1; transform: none; }
  }
  .mos-cell {
    position: relative;
    overflow: hidden;
    border-right: 1px solid var(--mf-hair);
    border-bottom: 1px solid var(--mf-hair);
    opacity: 0;
    animation: mosIn 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: calc(var(--i, 0) * 70ms);
  }
  .mos-cell-1 { grid-row: span 2; }
  .mos-cell-3, .mos-cell-5 { border-right: 0; }
  .mos-cell-4, .mos-cell-5 { border-bottom: 0; }
  .mos-link {
    display: block;
    width: 100%;
    height: 100%;
    cursor: zoom-in;
  }
  .mos-cell img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
  .mos-link:hover img { transform: scale(1.03); }
  .mos-cap {
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: 10px;
    width: fit-content;
    max-width: calc(100% - 20px);
    padding: 4px 8px;
    line-height: 1.35;
    background: rgba(27, 26, 22, 0.55);
    backdrop-filter: blur(8px);
    color: var(--mf-paper);
    font-family: var(--mf-font-mono);
    font-size: 9.5px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .mos-cta {
    position: absolute;
    right: 14px;
    bottom: 14px;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    background: var(--mf-paper);
    color: var(--mf-ink);
    font-size: 12px;
    font-weight: 600;
    border: 1px solid var(--mf-ink);
    box-shadow: 3px 3px 0 var(--mf-ink);
    transition: transform 0.15s;
  }
  .mos-cta:hover { transform: translate(-1px, -1px); }

  /* Sin esto el usuario ve 5 fotos y no sabe que hay 4-7 mas detras. */
  .mos-more {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    display: grid;
    place-items: center;
    background: rgba(27, 26, 22, 0.5);
    color: var(--mf-paper);
    font-family: var(--mf-font-mono);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding-bottom: 34px;
  }

  .mos-hint {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding: 0 28px 12px;
  }
  .mos-hint-count { letter-spacing: 0.1em; }

  @media (max-width: 720px) {
    .mosaic {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: none;
      grid-auto-rows: 1fr;
      gap: 8px;
      padding: 18px;
      background: var(--mf-paper);
      border-bottom: 0;
    }
    .mos-cell { border: 0; aspect-ratio: 1 / 1; }
    .mos-cell-1 { grid-row: span 1; grid-column: span 2; aspect-ratio: 16 / 10; }
    .mos-cta {
      right: 8px;
      bottom: 8px;
      padding: 8px 10px;
      font-size: 11px;
      gap: 6px;
      box-shadow: 2px 2px 0 var(--mf-ink);
    }
    .mos-more { font-size: 11px; padding-bottom: 28px; }
    .mos-hint { padding: 0 18px 10px; }
  }

  @media (max-width: 480px) {
    .mosaic { padding: 16px; gap: 6px; }
  }
</style>
