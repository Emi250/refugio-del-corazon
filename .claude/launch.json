{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "refugio-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 4321
    },
    {
      "name": "refugio-build",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
